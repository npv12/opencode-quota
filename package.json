{
  "name": "@npv12/opencode-quota",
  "version": "1.1.0",
  "description": "OpenCode quota visibility — sidebar panel and /quota command. By Pranav (npv12).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-quota": "./dist/bin/opencode-quota.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-data.mjs && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "quota",
    "sidebar",
    "github",
    "copilot",
    "openai",
    "anthropic",
    "google"
  ],
  "author": "Pranav <pranav10121@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npv12/opencode-quota.git"
  },
  "bugs": {
    "url": "https://github.com/npv12/opencode-quota/issues"
  },
  "homepage": "https://github.com/npv12/opencode-quota#readme",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "1.18.1",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "typescript": "7.0.2",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@opentui/core": "^0.5.3",
    "@opentui/solid": "^0.5.3",
    "comment-json": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.12",
    "xdg-basedir": "^5.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
